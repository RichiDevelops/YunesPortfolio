---
import Base from "../layouts/Base.astro";
import BackgroundFlares from "../components/BackgroundFlares.astro";
import SketchArrow from "../components/SketchArrow.astro";

const CLIENTS = [
  { name: "BastiGHG", tags: "Gaming · Minecraft", logo: "/images/bastighg.png", href: "https://www.youtube.com/@BastiGHG", views: "2.1B views", videos: "3,200 videos", highlight: false },
  { name: "Bastian", tags: "Channel Management · Gaming · Variety", logo: "/images/bastian.png", href: "https://www.youtube.com/@Bastian", views: "480M views", videos: "900 videos", highlight: true },
  { name: "BastiGHG Bonus", tags: "Channel Management · Gaming · Reactions", logo: "/images/bastighg-bonus.png", href: "https://www.youtube.com/@BastiGHGClips", views: "350M views", videos: "650 videos", highlight: false },
  { name: "LS Galabau", tags: "Channel Management · Garden Work", logo: "/images/ls-galabau.png", logoContain: true, href: "https://www.youtube.com/@ls.galabau", views: "15M views", videos: "180 videos", highlight: false },
];

const left = [CLIENTS[0], CLIENTS[2]];
const right = [CLIENTS[1], CLIENTS[3]];
---
<Base title="Frozen — Video Editing that drives engagement" description="Frozen. Experienced video editor building the engine for high-performing, successful videos.">
  <div class="relative min-h-screen text-foreground overflow-hidden" style="background: var(--gradient-ice);">
    <BackgroundFlares />

    <div class="relative z-10 mx-auto max-w-7xl px-6 pt-8">
      <nav id="nav" class="flex items-center justify-between transition-transform duration-500 ease-out">
        <a href="/" class="text-lg font-extrabold tracking-tight">Frozen<span class="text-brand">.</span></a>
        <div class="flex items-center gap-3">
          <button id="theme-toggle" aria-label="Toggle dark mode"
                  class="inline-flex h-10 w-10 items-center justify-center rounded-full glass transition-transform hover:scale-[1.05]">
            <svg id="icon-sun" class="hidden" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
            <svg id="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
          </button>
          <button id="contact-toggle"
                  class="group relative inline-flex items-center gap-2 rounded-full glass px-5 py-2.5 text-sm font-semibold tracking-wide transition-transform hover:scale-[1.02]">
            <span class="h-2 w-2 rounded-full bg-brand"></span>
            <span class="relative inline-block h-4 w-[72px] overflow-hidden text-center">
              <span id="contact-toggle-label" class="absolute inset-0 flex items-center justify-center transition-all duration-300 ease-out group-hover:-translate-y-2 group-hover:opacity-0">REQUEST</span>
              <span class="absolute inset-0 flex items-center justify-center translate-y-2 opacity-0 transition-all duration-300 ease-out group-hover:translate-y-0 group-hover:opacity-100">;)</span>
            </span>
          </button>
        </div>
      </nav>

      <main id="main" class="relative grid grid-cols-1 lg:grid-cols-[1.1fr_0.9fr] gap-12 lg:gap-16 items-start pt-16 pb-16">
        {/* <SketchArrow variant="hero" delay={400} className="hidden lg:block left-[28%] top-[-20px] w-[70%] h-[620px] z-[1]" group="default" /> */}

        <section id="hero-left" class="relative z-10 transition-transform duration-500 ease-out">
           <div aria-hidden class="pointer-events-none select-none absolute -top-10 -left-8 text-[180px] leading-none font-black" style="color: color-mix(in oklab, var(--foreground) 6%, transparent);">01</div>

          <div class="relative mb-3 inline-block font-hand text-brand text-4xl sm:text-5xl -rotate-[6deg] translate-x-2">Frozen.</div>

          <h1 class="text-[54px] leading-[0.95] sm:text-[68px] lg:text-[84px] font-extrabold tracking-tight">
            <span class="block">Video</span>
            <span class="flex items-center gap-4 flex-wrap">
              <span>editing</span>
              <span class="relative inline-flex -space-x-3 align-middle">
                <span class="h-12 w-12 sm:h-14 sm:w-14 rounded-2xl overflow-hidden ring-2 ring-white/80 dark:ring-white/15 shadow-[0_10px_30px_-10px_var(--brand-glow)] -rotate-12 bg-white/60 dark:bg-white/5 grid place-items-center transition-transform duration-300 hover:-translate-y-1 hover:rotate-0">
                  <img src="/images/after-effects.png" alt="After Effects" class="h-8 w-8 sm:h-10 sm:w-10 object-contain" />
                </span>
                <span class="h-12 w-12 sm:h-14 sm:w-14 rounded-2xl overflow-hidden ring-2 ring-white/80 dark:ring-white/15 shadow-[0_10px_30px_-10px_var(--brand-glow)] rotate-12 bg-white/60 dark:bg-white/5 grid place-items-center transition-transform duration-300 hover:-translate-y-1 hover:rotate-0">
                  <img src="/images/premiere-pro.png" alt="Premiere Pro" class="h-8 w-8 sm:h-10 sm:w-10 object-contain" />
                </span>
              </span>
            </span>
            <span class="block">that drives</span>
            <span class="relative inline-block text-brand">
              engagement.
               {/*<SketchArrow variant="tools" delay={900} className="hidden sm:block -right-[240px] -bottom-[40px] w-[260px] h-[200px] z-[5]" group="default" /> */}
            </span>
          </h1>

          <p class="mt-10 max-w-lg text-base text-muted-foreground">
            I'm <span class="font-semibold text-foreground">Frozen</span> — an experienced video editor shaped by years in the social media ecosystem. I build the engine for high-performing, successful videos.
          </p>
        </section>

        <aside id="hero-right" class="relative z-10 min-h-[400px] grid [contain:layout_style]">
          <div id="clients-block" class="panel is-active" style="--panel-offset: -1rem;">
            <h2 class="text-sm font-semibold uppercase tracking-wider text-muted-foreground">Current clients</h2>
            <div class="mt-4 grid grid-cols-2 gap-4 relative">
              <div class="space-y-4 pt-12">
                {left.map((c) => (
                  <a href={c.href} target="_blank" rel="noopener noreferrer"
                     class={`group block rounded-3xl glass glass-subtle p-4 transition-all duration-300 ease-out hover:-translate-y-1 hover:shadow-[0_20px_50px_-15px_var(--brand-glow)] cursor-pointer`}>
                    <div class="flex items-center justify-between mb-3">
                      <div class="h-10 w-10 rounded-full overflow-hidden bg-white/60 border border-white/70 grid place-items-center">
                        <img src={c.logo} alt={`${c.name} logo`} class={c.logoContain ? "h-8 w-8 object-contain" : "h-full w-full object-cover"} />
                      </div>
                      <span class="text-[10px] font-semibold uppercase tracking-wider text-brand bg-brand/10 rounded-md px-2 py-0.5">Live</span>
                    </div>
                    <div class="text-sm font-semibold truncate group-hover:text-brand transition-colors">{c.name}</div>
                    <div class="text-[11px] text-muted-foreground mt-0.5 line-clamp-1">{c.tags}</div>
                    <div class="mt-3 pt-3 border-t border-white/40 dark:border-white/10 flex items-baseline justify-between">
                      <span class="text-sm font-semibold text-brand">{c.views}</span>
                      <span class="text-[10px] text-muted-foreground">{c.videos}</span>
                    </div>
                  </a>
                ))}
              </div>
              <div class="space-y-4">
                {right.map((c) => (
                  <a href={c.href} target="_blank" rel="noopener noreferrer"
                     class={`group block rounded-3xl glass glass-subtle p-4 transition-all duration-300 ease-out hover:-translate-y-1 hover:shadow-[0_20px_50px_-15px_var(--brand-glow)] cursor-pointer ${c.highlight ? "ring-1 ring-brand/40 shadow-[0_10px_40px_-15px_var(--brand-glow)]" : ""}`}>
                    <div class="flex items-center justify-between mb-3">
                      <div class="h-10 w-10 rounded-full overflow-hidden bg-white/60 border border-white/70 grid place-items-center">
                        <img src={c.logo} alt={`${c.name} logo`} class={c.logoContain ? "h-8 w-8 object-contain" : "h-full w-full object-cover"} />
                      </div>
                      <span class="text-[10px] font-semibold uppercase tracking-wider text-brand bg-brand/10 rounded-md px-2 py-0.5">Live</span>
                    </div>
                    <div class="text-sm font-semibold truncate group-hover:text-brand transition-colors">{c.name}</div>
                    <div class="text-[11px] text-muted-foreground mt-0.5 line-clamp-1">{c.tags}</div>
                    <div class="mt-3 pt-3 border-t border-white/40 dark:border-white/10 flex items-baseline justify-between">
                      <span class="text-sm font-semibold text-brand">{c.views}</span>
                      <span class="text-[10px] text-muted-foreground">{c.videos}</span>
                    </div>
                  </a>
                ))}
              </div>
            </div>
            <div class="mt-6 pt-4 pl-2 flex items-baseline gap-4 font-hand text-foreground/85">
              <div class="flex items-baseline gap-2">
                <span class="text-4xl leading-none">2.9B+</span>
                <span class="text-lg text-muted-foreground">total views</span>
              </div>
              <span class="text-2xl text-muted-foreground/60">·</span>
              <div class="flex items-baseline gap-2">
                <span class="text-4xl leading-none">100+</span>
                <span class="text-lg text-muted-foreground">videos</span>
              </div>
            </div>
          </div>

          <div id="contact-block" class="panel" style="--panel-offset: 2rem;">
            <form id="contact-form" class="glass glass-subtle rounded-3xl p-6 sm:p-7 space-y-6">
              <input type="hidden" name="access_key" value="YOUR_WEB3FORMS_ACCESS_KEY" />
              <input type="hidden" name="subject" value="Neue Kontaktanfrage — Frozen Portfolio" />
              <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

              <div>
                <div class="text-xs font-semibold uppercase tracking-widest text-brand">Contact information</div>
                <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-3">
                  <label class="block">
                    <span class="block text-[11px] font-semibold uppercase tracking-wider text-muted-foreground mb-1.5">Name<span class="text-brand"> *</span></span>
                    <input type="text" name="name" required placeholder="Your full name"
                      class="w-full rounded-xl px-3.5 py-2.5 text-sm placeholder:text-muted-foreground/70 outline-none transition-colors"
                      style="background:var(--field-bg);border:1px solid var(--field-border);" />
                  </label>
                  <label class="block">
                    <span class="block text-[11px] font-semibold uppercase tracking-wider text-muted-foreground mb-1.5">Company name<span class="text-brand"> *</span></span>
                    <input type="text" name="company" required placeholder="Company / Brand"
                      class="w-full rounded-xl px-3.5 py-2.5 text-sm placeholder:text-muted-foreground/70 outline-none transition-colors"
                      style="background:var(--field-bg);border:1px solid var(--field-border);" />
                  </label>
                  <label class="block">
                    <span class="block text-[11px] font-semibold uppercase tracking-wider text-muted-foreground mb-1.5">Email<span class="text-brand"> *</span></span>
                    <input type="email" name="email" required placeholder="you@domain.com"
                      class="w-full rounded-xl px-3.5 py-2.5 text-sm placeholder:text-muted-foreground/70 outline-none transition-colors"
                      style="background:var(--field-bg);border:1px solid var(--field-border);" />
                  </label>
                  <label class="block">
                    <span class="block text-[11px] font-semibold uppercase tracking-wider text-muted-foreground mb-1.5">Website<span class="text-brand"> *</span></span>
                    <input type="url" name="website" required placeholder="https://…"
                      class="w-full rounded-xl px-3.5 py-2.5 text-sm placeholder:text-muted-foreground/70 outline-none transition-colors"
                      style="background:var(--field-bg);border:1px solid var(--field-border);" />
                  </label>
                </div>
              </div>

              <div>
                <div class="text-xs font-semibold uppercase tracking-widest text-brand">Project information</div>
                <label class="mt-4 block">
                  <span class="sr-only">Information about your project</span>
                  <textarea name="project" required rows="5" placeholder="Information about your project…"
                    class="w-full resize-none rounded-2xl px-4 py-3 text-sm placeholder:text-muted-foreground/70 outline-none transition-colors"
                    style="background:var(--field-bg);border:1px solid var(--field-border);"></textarea>
                </label>
              </div>

              <label class="flex items-start gap-3 text-sm select-none cursor-pointer">
                <input id="agree" type="checkbox" required class="mt-0.5 h-4 w-4 rounded border-white/70" style="accent-color:var(--brand);" />
                <span class="text-muted-foreground">
                  I have read and agree to the
                  <a href="#" class="text-foreground font-medium underline decoration-brand/50 underline-offset-2">Privacy Policy</a> &
                  <a href="#" class="text-foreground font-medium underline decoration-brand/50 underline-offset-2">Imprint</a>.
                </span>
              </label>

              <button id="submit-btn" type="submit"
                class="group w-full inline-flex items-center justify-center gap-2 rounded-full glass px-6 py-3 text-sm font-semibold tracking-wide transition-all hover:scale-[1.01] disabled:opacity-60 disabled:cursor-not-allowed">
                <span id="submit-label">Submit your request</span>
                <span class="transition-transform group-hover:translate-x-1">→</span>
              </button>
            </form>
            { /*<SketchArrow variant="contact" delay={500} className="hidden lg:block -right-[280px] top-[40px] w-[340px] h-[420px] z-[5]" group="contact" /> */}
          </div>
        </aside>
      </main>

      <footer class="pb-10 flex items-center justify-between text-sm text-muted-foreground pt-6" style="border-top:1px solid var(--footer-border);">
        <span>© Frozen 2026</span>
        <span class="font-mono">Frozen.</span>
      </footer>
    </div>
  </div>

  <script>
    // Theme toggle
    const root = document.documentElement;
    const sun = document.getElementById("icon-sun")!;
    const moon = document.getElementById("icon-moon")!;
    const syncIcons = () => {
      if (root.classList.contains("dark")) { sun.classList.remove("hidden"); moon.classList.add("hidden"); }
      else { sun.classList.add("hidden"); moon.classList.remove("hidden"); }
    };
    syncIcons();
    document.getElementById("theme-toggle")!.addEventListener("click", () => {
      const isDark = root.classList.toggle("dark");
      try { localStorage.setItem("theme", isDark ? "dark" : "light"); } catch {}
      syncIcons();
    });

    // Sketch arrows: show = draw in (respecting each arrow's own delay),
    // hide = reset instantly. A single generation counter cancels any pending
    // show timers, so rapid toggling can never reveal a stale-state arrow.
    let arrowGen = 0;
    const showArrows = (group: string) => {
      const gen = ++arrowGen;
      document.querySelectorAll<SVGElement>(`svg[data-arrow][data-group="${group}"]`).forEach((svg) => {
        const delay = parseInt(svg.style.getPropertyValue("--arrow-delay")) || 0;
        setTimeout(() => { if (gen === arrowGen) svg.classList.add("is-visible"); }, delay);
      });
    };
    const hideArrows = (group: string) => {
      arrowGen++; // invalidate any pending show timers
      document.querySelectorAll<SVGElement>(`svg[data-arrow][data-group="${group}"]`).forEach((svg) => {
        svg.classList.add("is-resetting");
        svg.classList.remove("is-visible");
        requestAnimationFrame(() => svg.classList.remove("is-resetting"));
      });
    };
    /*showArrows("default"); */

    // Contact panel toggle
    const nav = document.getElementById("nav")!;
    const heroLeft = document.getElementById("hero-left")!;
    const heroRight = document.getElementById("hero-right")!;
    const clientsBlock = document.getElementById("clients-block")!;
    const contactBlock = document.getElementById("contact-block")!;
    const contactLabel = document.getElementById("contact-toggle-label")!;

    let open = false;

    contactBlock.addEventListener("transitionend", (e) => {
      if (e.propertyName === "opacity") heroRight.classList.remove("is-animating");
    });

    document.getElementById("contact-toggle")!.addEventListener("click", () => {
      open = !open;
      contactLabel.textContent = open ? "CLOSE" : "REQUEST";
      nav.style.transform = open ? "translateX(-2%)" : "translateX(0)";
      heroLeft.style.transform = open ? "translateX(-2%)" : "translateX(0)";

      // Suspend the costly full backdrop-filter for the crossfade; the
      // transitionend listener above restores it once the panel settles.
      heroRight.classList.add("is-animating");

      clientsBlock.classList.toggle("is-active", !open);
      contactBlock.classList.toggle("is-active", open);

      // Hide the outgoing group's arrows immediately, draw in the incoming
      // group's arrows only after the panel has finished sliding.
      /*hideArrows(open ? "default" : "contact");
      showArrows(open ? "contact" : "default");*/
    });

    // Contact form submission via Web3Forms
    const form = document.getElementById("contact-form") as HTMLFormElement;
    const btn = document.getElementById("submit-btn") as HTMLButtonElement;
    const label = document.getElementById("submit-label")!;
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      btn.disabled = true;
      label.textContent = "Sending…";
      try {
        const data = new FormData(form);
        const res = await fetch("https://api.web3forms.com/submit", { method: "POST", body: data });
        const json = await res.json();
        if (json.success) {
          label.textContent = "Request sent";
        } else {
          label.textContent = "Failed — try again";
          btn.disabled = false;
        }
      } catch {
        label.textContent = "Failed — try again";
        btn.disabled = false;
      }
    });
  </script>
</Base>
